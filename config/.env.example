# =============================================================================
# Senjougahara — .env.example
# Copy this to .env (gitignored) and fill in your real values.
# NEVER commit the real .env file.
# =============================================================================

# ─── LLM Provider API Keys ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Ollama (local LLMs) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── TTS Engine (AivisSpeech default port: 10101, VOICEVOX: 50021) ────────────
TTS_ENGINE_BASE_URL=http://127.0.0.1:10101
TTS_SPEAKER_ID=888753760

# ─── Avatar Bridge ────────────────────────────────────────────────────────────
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
